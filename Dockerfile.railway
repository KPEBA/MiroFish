# Single-service image for Railway: MiroFish backend + built Vue frontend + Swarm Town game.
# Railway: set variable RAILWAY_DOCKERFILE_PATH=Dockerfile.railway

# ---- 1. Build MiroFish frontend (same-origin API: VITE_API_BASE_URL=/) ----
FROM node:22-slim AS web
# Keep the repo layout: the frontend imports ../../../locales/*.json
WORKDIR /web/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY locales/ /web/locales/
COPY frontend/ ./
ENV VITE_API_BASE_URL=/
RUN npm run build

# ---- 2. Runtime: Python 3.11 (camel-oasis 0.2.5 requires <3.12) ----
FROM python:3.11
COPY --from=ghcr.io/astral-sh/uv:0.9.26 /uv /bin/uv

ENV PYTHONUNBUFFERED=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/app/backend/.venv

WORKDIR /app/backend
COPY backend/pyproject.toml backend/uv.lock ./
# Same pinned versions as uv.lock, but CPU-only torch: the locked CUDA build
# adds ~8 GB of nvidia wheels that are useless without a GPU.
RUN uv venv --python /usr/local/bin/python3 /app/backend/.venv \
  && uv pip install --python /app/backend/.venv/bin/python torch==2.9.1 \
       --index-url https://download.pytorch.org/whl/cpu \
  && uv export --frozen --no-hashes --no-dev --no-emit-project 2>/dev/null \
       | grep -viE '^(torch|nvidia-|triton)' | grep -vE '^\s*(#|$)' > /tmp/req.txt \
  && uv pip install --python /app/backend/.venv/bin/python -r /tmp/req.txt \
  && rm -rf /root/.cache/uv /tmp/req.txt

COPY backend/ ./
COPY locales/ /app/locales/
COPY --from=web /web/frontend/dist /app/frontend/dist
COPY game/ /app/game/

ENV PATH="/app/backend/.venv/bin:$PATH"
EXPOSE 8080
CMD ["python", "railway_app.py"]
